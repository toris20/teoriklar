*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,sans-serif;background:#f3f6f4;color:#17211c}header{background:#123d2b;color:white;padding:14px max(18px,calc((100% - 760px)/2));display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:3}.brand{font-weight:900;letter-spacing:1.5px}main{max-width:760px;margin:auto;padding:22px 16px 70px}.card{background:white;border-radius:18px;padding:22px;box-shadow:0 5px 22px #173e2920;margin:14px 0}h1{font-size:clamp(28px,8vw,48px);line-height:1.05;margin:.2em 0}h2{margin-top:0}.lead{font-size:18px;color:#43534a}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:13px}.btn,button{border:0;border-radius:13px;padding:15px 18px;font-size:16px;font-weight:750;cursor:pointer}.primary{background:#146b49;color:white}.secondary{background:#e5f1eb;color:#103e2c}.ghost{background:#ffffff22;color:white;padding:9px 13px}.answer{width:100%;text-align:left;margin:7px 0;background:#f0f3f1;border:2px solid transparent}.answer:hover{border-color:#4f8c71}.answer.good{background:#d8f3e2;border-color:#25844c}.answer.bad{background:#ffe0dc;border-color:#b83c32}.answer:disabled{color:#17211c}.bar{height:10px;background:#dfe6e2;border-radius:9px;overflow:hidden}.bar span{display:block;height:100%;background:#1b8057}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between}.pill{display:inline-block;background:#e5f1eb;padding:7px 11px;border-radius:999px;font-size:13px}.explain{border-left:5px solid #1b8057;background:#eef8f2;padding:14px;border-radius:9px;margin-top:14px}.danger{color:#a12620}.stat{font-size:32px;font-weight:900}.muted{color:#66736c}.toggle{display:flex;gap:8px}.toggle button.active{background:#146b49;color:white}select{width:100%;padding:14px;border:1px solid #bcc9c1;border-radius:12px;font-size:16px}.speak{background:#fff3ce}.hidden{display:none}@media(max-width:500px){.card{padding:17px}main{padding:15px 12px 60px}.btn{width:100%}}